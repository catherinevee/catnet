# Test Environment Configuration
DATABASE_URL=sqlite+aiosqlite:///:memory:
REDIS_URL=redis://localhost:6379/0

# Security Settings
SECRET_KEY=test-secret-key-for-testing-only-change-in-production
JWT_ALGORITHM=RS256
JWT_EXPIRE_MINUTES=30
MFA_ISSUER=CatNet-Test

# HashiCorp Vault
VAULT_URL=http://localhost:8200
VAULT_TOKEN=test-vault-token
VAULT_MOUNT_POINT=secret
VAULT_NAMESPACE=catnet

# Message Queue
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Git Settings
GIT_DEFAULT_BRANCH=main
GIT_WEBHOOK_SECRET=test-webhook-secret
GPG_VERIFICATION_ENABLED=false

# Deployment Settings
CANARY_STAGES=5,25,50,100
CANARY_WAIT_MINUTES=5,10,15,0
ROLLBACK_TIMEOUT_SECONDS=300
MAX_PARALLEL_DEPLOYMENTS=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
AUDIT_LOG_PATH=/tmp/catnet/audit.log

# Environment
ENVIRONMENT=development

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# TLS/mTLS (disabled for tests)
MTLS_ENABLED=false
VERIFY_CLIENT_CERT=false

# Session Recording
SESSION_RECORDING_ENABLED=false

# Network Device Defaults
DEFAULT_DEVICE_TIMEOUT=30
DEFAULT_DEVICE_PORT_SSH=22
ENABLE_TELNET=false
