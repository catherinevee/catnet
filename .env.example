# Database Configuration
DATABASE_URL=postgresql+asyncpg://catnet:catnet_password@localhost:5432/catnet
REDIS_URL=redis://localhost:6379/0

# Security Settings
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=RS256
JWT_EXPIRE_MINUTES=30
MFA_ISSUER=CatNet

# HashiCorp Vault
VAULT_URL=http://localhost:8200
VAULT_TOKEN=your-vault-token
VAULT_MOUNT_POINT=secret
VAULT_NAMESPACE=catnet

# LDAP/AD Configuration
LDAP_SERVER=ldap://localhost:389
LDAP_BIND_DN=cn=admin,dc=catnet,dc=local
LDAP_BIND_PASSWORD=ldap_password
LDAP_BASE_DN=dc=catnet,dc=local

# OAuth2/SAML
OAUTH_CLIENT_ID=catnet-client-id
OAUTH_CLIENT_SECRET=catnet-client-secret
SAML_IDP_URL=https://idp.catnet.local/saml
SAML_SP_ENTITY_ID=catnet-sp

# Message Queue
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Service Ports
AUTH_SERVICE_PORT=8081
GITOPS_SERVICE_PORT=8082
DEPLOYMENT_SERVICE_PORT=8083
DEVICE_SERVICE_PORT=8084

# TLS/mTLS Configuration
TLS_CERT_PATH=/etc/catnet/certs/server.crt
TLS_KEY_PATH=/etc/catnet/certs/server.key
TLS_CA_PATH=/etc/catnet/certs/ca.crt
MTLS_ENABLED=true
VERIFY_CLIENT_CERT=true

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_URL=http://localhost:3000

# Git Settings
GIT_DEFAULT_BRANCH=main
GIT_WEBHOOK_SECRET=your-webhook-secret
GPG_VERIFICATION_ENABLED=true

# Deployment Settings
CANARY_STAGES=5,25,50,100
CANARY_WAIT_MINUTES=5,10,15,0
ROLLBACK_TIMEOUT_SECONDS=300
MAX_PARALLEL_DEPLOYMENTS=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
AUDIT_LOG_PATH=/var/log/catnet/audit.log

# Encryption
ENCRYPTION_ALGORITHM=AES-256-GCM
KMS_KEY_ID=arn:aws:kms:us-west-2:123456789012:key/12345678-1234

# Network Device Defaults
DEFAULT_DEVICE_TIMEOUT=30
DEFAULT_DEVICE_PORT_SSH=22
DEFAULT_DEVICE_PORT_TELNET=23
ENABLE_TELNET=false

# Session Recording
SESSION_RECORDING_ENABLED=true
SESSION_RECORDING_PATH=/var/log/catnet/sessions/

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Environment
ENVIRONMENT=development